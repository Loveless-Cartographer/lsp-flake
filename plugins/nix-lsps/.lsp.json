{
  "bash-language-server": {
    "command": "bash-language-server",
    "args": ["start"],
    "extensionToLanguage": {
      ".sh": "shellscript",
      ".bash": "shellscript",
      ".zsh": "shellscript",
      ".ksh": "shellscript",
      ".bashrc": "shellscript"
    }
  },
  "intelephense": {
    "command": "intelephense",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".php": "php",
      ".phtml": "php",
      ".php4": "php",
      ".php5": "php",
      ".module": "php",
      ".inc": "php"
    }
  },
  "jdtls": {
    "command": "jdtls",
    "extensionToLanguage": {
      ".java": "java"
    }
  },
  "kotlin-language-server": {
    "command": "kotlin-language-server",
    "extensionToLanguage": {
      ".kt": "kotlin",
      ".kts": "kotlin"
    }
  },
  "nixd": {
    "command": "nixd",
    "extensionToLanguage": {
      ".nix": "nix"
    }
  },
  "pyright": {
    "command": "pyright-langserver",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python",
      ".pyw": "python"
    }
  },
  "rust-analyzer": {
    "command": "rust-analyzer",
    "extensionToLanguage": {
      ".rs": "rust"
    }
  },
  "typescript-language-server": {
    "command": "typescript-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".mts": "typescript",
      ".cts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".mjs": "javascript",
      ".cjs": "javascript",
      ".jsx": "javascriptreact"
    }
  },
  "vue-language-server": {
    "command": "vue-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".vue": "vue"
    }
  },
  "yaml-language-server": {
    "command": "yaml-language-server",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".yaml": "yaml",
      ".yml": "yaml"
    }
  }
}
